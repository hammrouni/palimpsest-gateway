# palimpsest-gateway configuration
# All settings are read from PALIMPSEST_*-prefixed environment variables
# (see app/config.py Settings). Copy to .env and adjust as needed.
#
#   cp .env.example .env
#
# .env is gitignored and is the one file that must never be committed.

# ===========================================================================
# REQUIRED — generate these before starting the gateway
# ===========================================================================

# Fernet key used to encrypt provider and operator credentials at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WARNING: this key is not recoverable. Changing or losing it makes every
# credential already stored in Redis permanently undecryptable — you will have
# to re-add every provider key through the Operator API.
PALIMPSEST_GATE_MASTER_KEY=

# Bootstrap operator key, seeded idempotently on startup. Format: pgw_opk_<random>.
# Generate with:
#   python -c "import secrets; print('pgw_opk_' + secrets.token_urlsafe(32))"
#
# Leave empty to skip: with no operator key the Operator API and the dashboard
# have no way to authenticate until one is created.
PALIMPSEST_GATE_OPERATOR_KEY=

# Print the operator key and dashboard URL in the container's startup log.
# Set false wherever container logs are collected or shared.
PALIMPSEST_LOG_OPERATOR_KEY=true

# ===========================================================================
# Provider
# ===========================================================================

# Single-key shortcut: added to the pool on startup for PROVIDER_NAME, serving
# PROVIDER_MODEL (the model string clients request). Never echoed to clients.
# Manage additional keys at runtime through the Operator API instead.
PALIMPSEST_PROVIDER_NAME=openai
PALIMPSEST_PROVIDER_MODEL=gpt-4o-mini
PALIMPSEST_PROVIDER_API_KEY=
# Seconds per provider attempt.
PALIMPSEST_PROVIDER_TIMEOUT=60.0

# Self-service signup (POST /v1/accounts). Set false on any gateway reachable by
# people who should not spend your pool; account creation then needs an operator key.
PALIMPSEST_ALLOW_SIGNUP=true

# Seconds between re-reads of operator config overrides, so a runtime change
# reaches every instance. 0 disables.
PALIMPSEST_CONFIG_REFRESH_SECONDS=5

# Provider adapter base URLs.
PALIMPSEST_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PALIMPSEST_OPENAI_BASE_URL=

# ===========================================================================
# Store
# ===========================================================================

# Inside Docker Compose the app reaches Redis at redis://redis:6379/0.
# Running the app directly on the host, use redis://localhost:6379/0.
PALIMPSEST_REDIS_URL=redis://redis:6379/0

# Cross-origin access. Empty by default: the dashboard is served from this same
# origin and non-browser clients ignore CORS, so nothing extra is needed. Add a
# JSON array only if a browser app on another origin must call the gateway, e.g.
# PALIMPSEST_CORS_ORIGINS=["http://localhost:3000"]
# A malformed value is ignored rather than treated as a wildcard.
PALIMPSEST_CORS_ORIGINS=[]

# ===========================================================================
# Session
# ===========================================================================

# Maximum length of a client-supplied X-Session-ID header.
PALIMPSEST_MAX_SESSION_ID_LENGTH=128

# Session-turn lock contention policy: brief-queue-then-reject.
# A turn that cannot acquire the session lock within WAIT_MS (polling every
# POLL_MS) fails with 423 session_busy.
PALIMPSEST_SESSION_LOCK_WAIT_MS=2000
PALIMPSEST_SESSION_LOCK_POLL_MS=100

# Create a session for an unknown client-supplied X-Session-ID instead of
# returning 404 session_not_found. Enable for clients that invent their own
# conversation IDs. Sessions stay per-account either way.
PALIMPSEST_AUTO_CREATE_SESSIONS=false

# Operator statistics (Usage / Sessions / Requests pages in the dashboard).
# Days of per-account, per-model token counters kept, and how many recent
# request records are retained.
PALIMPSEST_USAGE_RETENTION_DAYS=90
PALIMPSEST_USAGE_RECENT_MAX=500

# Raw turns kept verbatim in the failover context.
PALIMPSEST_VERBATIM_TURNS_N=4

# Include the current turn's prompts in request logs (opt-in, default off).
# Stored session history is never logged regardless of this setting.
PALIMPSEST_REQUEST_LOG_PROMPTS=false

# ===========================================================================
# Failover
# ===========================================================================

PALIMPSEST_COOLDOWN_SECONDS=60
PALIMPSEST_RETRY_BUDGET=3

# ===========================================================================
# Settlement, fairness and pool visibility
# ===========================================================================

# Canonical request-event TTL.
PALIMPSEST_REQUEST_LOG_TTL_HOURS=24

# Settlement idempotency marker TTL. Must exceed the longest plausible single
# request (PROVIDER_TIMEOUT x RETRY_BUDGET) so a long streaming settlement is
# never treated as a duplicate.
PALIMPSEST_SETTLE_ID_TTL_SECONDS=300

# Pool low-water-mark throttle (0 = disabled) and the default per-user daily cap
# (empty = no per-user cap; the pool layer still applies).
PALIMPSEST_POOL_LOW_WATER_MARK=0
PALIMPSEST_USER_DAILY_CAP=

# Bound on the failover-events mirror list
# (GET /v1/operator/pool/failover-events).
PALIMPSEST_FAILOVER_EVENT_LOG_SIZE=1000